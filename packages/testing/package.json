{
  "name": "@machinapractica/testing",
  "version": "0.1.0-alpha.1",
  "description": "Semantic evidence receipts and bounded test coordination",
  "type": "module",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/machinapractica/packages.git",
    "directory": "packages/testing"
  },
  "homepage": "https://github.com/machinapractica/packages",
